# ============================================================
# Lakshya Stage-Gate Portal — Backend Server Environment
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is listed in .gitignore.

# Express server port
PORT=3001

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://postgres:<db-password>@<host>:5432/postgres

# JWT secret — generate with: node -e "require('crypto').randomBytes(64).toString('base64')"
JWT_SECRET=<generate-a-secure-random-secret>
JWT_EXPIRES_IN=24h

# ---- SMTP (Gmail App Password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail-address>
SMTP_PASS=<your-gmail-app-password>
SMTP_FROM=<your-gmail-address>

# App public URL (used in email links)
APP_BASE_URL=http://localhost:5173

# ---- Supabase (server-side only) ----
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>

# SERVICE ROLE KEY — server-side only, NEVER expose in frontend code
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ---- Seed / Smoke-test credentials (dev only) ----
SEED_ADMIN_PASSWORD=<set-a-strong-password-for-seeding>
SMOKE_TEST_EMAIL=<test-admin-email>
SMOKE_TEST_PASSWORD=<test-admin-password>
